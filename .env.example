# .env.example
# 範例環境變數檔案 (不要把真正的金鑰提交到版本控制)
# 將本檔複製為 .env 並填入您的金鑰與設定：
#   cp .env.example .env

# ═══════════════════════════════════════════════════════════════
# 🤖 Dify Chatflow API 配置（主問答後端）
# ═══════════════════════════════════════════════════════════════

# Dify API base URL（結尾不需要加 /）
DIFY_API_BASE="https://dify.brianhan.cc/v1"

# Dify App API 金鑰（從 Dify Studio → API Access 取得）
DIFY_API_KEY="app-xxxxxxxxxxxxxxxxxxxx"

# 識別使用者的標識符（用於 Dify 對話記錄分組）
DIFY_USER="resumemate-visitor"

# ═══════════════════════════════════════════════════════════════
# 🤖 CMS AI 助手配置（Infographic 標題翻譯與標籤建議）
# ═══════════════════════════════════════════════════════════════

# LiteLLM Proxy 配置（CMS InfographicAssistantAgent 使用）
LITELLM_PROXY_API_BASE="your_litellm_proxy_api_base"
LITELLM_PROXY_API_KEY="your_litellm_proxy_api_key"
LITELLM_PROXY_MODEL="gpt-5-mini"

# Gradio / 服務設定
GRADIO_SERVER_NAME="0.0.0.0"
GRADIO_SERVER_PORT=7860
# 啟用 Gradio 共享模式，生成公開 URL 供外部訪問
# 可選值：true (啟用共享), false (禁用共享)
# - true: 生成臨時公開 URL (例如 https://xxxxx.gradio.live)，任何人可訪問
# - false: 僅在本地網絡訪問，更安全但需要配置網絡
GRADIO_SHARE="false"

# ═══════════════════════════════════════════════════════════════
# 📊 CMS Admin 設定
# ═══════════════════════════════════════════════════════════════
# Admin 介面獨立於主應用運行，使用不同的連接埠
CMS_ADMIN_HOST="0.0.0.0"
CMS_ADMIN_PORT=7870
CMS_ADMIN_SHARE="false"
# Admin 認證 (建議在生產環境更改預設值)
CMS_ADMIN_USER="admin"
CMS_ADMIN_PASS="changeme"

# ═══════════════════════════════════════════════════════════════
# 📋 日誌配置
# ═══════════════════════════════════════════════════════════════
# 控制台日誌級別 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_CONSOLE_LEVEL="INFO"
# 檔案日誌級別
LOG_FILE_LEVEL="DEBUG"
# 日誌檔案路徑 (留空則不寫入檔案)
LOG_FILE="logs/resumemate.log"

# 安全提醒：
# - 不要在公開倉庫提交含有實際金鑰的 .env 檔案
# - 使用 CI / secret manager 保存生產環境金鑰


# CMS Git 自動提交設定
CMS_GIT_AUTO_COMMIT="false"
CMS_GIT_AUTO_PUSH="false"
CMS_GIT_COMMIT_PREFIX="[cms]"
