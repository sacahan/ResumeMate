{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ResumeMate Gradio",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "python": "${workspaceFolder}/.venv/bin/python",
      "serverReadyAction": {
        "pattern": "Running on local URL:\\s+http://\\S+:(\\d+)",
        "uriFormat": "http://localhost:%s",
        "action": "openExternally"
      },
      "env": {
        "GRADIO_SERVER_NAME": "0.0.0.0",
        "GRADIO_SERVER_PORT": "7860",
        "GRADIO_SHARE": "false",
        "GRADIO_DEBUG": "true"
      }
    },
    {
      "name": "Content Admin",
      "type": "debugpy",
      "request": "launch",
      "module": "src.backend.cms.admin_app",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "python": "${workspaceFolder}/.venv/bin/python",
      "env": {
        "CMS_ADMIN_USER": "admin",
        "CMS_ADMIN_PASS": "changeme"
      }
    }
  ]
}
